 "statements": [
  {
   "id": "environment-L2-B0899-1",
   "about": [
    "지구 온난화"
   ],
   "claim": "지구 온난화는 지구의 평균 기온이 장기적으로 높아지는 현상이다. 기후 변화는 기온뿐 아니라 강수, 바람, 계절의 길이, 극한 현상 등의 장기적인 변화까지 포함한다. 어느 지역에 추운 날이 있었다는 사실과 전 지구의 장기 평균 기온이 상승한다는 사실은 함께 성립할 수 있다. 하루의 날씨와 수십 년에 걸친 기후는 시간 범위가 다르기 때문이다.",
   "truth": true,
   "source": {
    "kind": "lecture",
    "volume": 2,
    "section": "P09",
    "blockId": "L2-B0899",
    "locator": "강의 2권 P09 / L2-B0899",
    "priorAuditExamIds": []
   },
   "practice": "sourceReading",
   "exhaustive": false
  },
  {
   "id": "environment-L2-B0956-2",
   "about": [
    "사막화"
   ],
   "claim": "미국 지도 A는 동부에서 심한 산성 강수를 나타낸다. 발전·산업·교통에서 발생한 오염 물질과 그 이동이 영향을 미친다. B는 상대적으로 건조한 서부에 넓게 나타나는 사막화 관련 분포이다. 동부와 서부라는 위치 차이뿐 아니라 화석 연료 연소에서 시작하는 대기 오염과, 수분 부족·토지 이용에서 시작하는 토지 황폐화라는 과정의 차이도 함께 읽는다.",
   "truth": true,
   "source": {
    "kind": "lecture",
    "volume": 2,
    "section": "P09",
    "blockId": "L2-B0956",
    "locator": "강의 2권 P09 / L2-B0956",
    "priorAuditExamIds": [
     "2014_9_14"
    ]
   },
   "practice": "sourceReading",
   "exhaustive": false
  },
  {
   "id": "environment-L2-B0980-3",
   "about": [
    "열대림 파괴"
   ],
   "claim": "열대림 파괴는 고온 다습한 열대 지역의 산림이 벌목되거나 농경지·목장·광산·도로 등으로 전환되면서 숲의 면적과 기능이 줄어드는 현상이다. 사막화와 마찬가지로 식생 감소와 토양 침식이 나타날 수 있지만, 주된 기후 배경과 토지 이용의 목적이 다르다.",
   "truth": true,
   "source": {
    "kind": "lecture",
    "volume": 2,
    "section": "P09",
    "blockId": "L2-B0980",
    "locator": "강의 2권 P09 / L2-B0980",
